{
	# ACME account email (Let's Encrypt expiry notices). Env: ACME_EMAIL.
	email {$ACME_EMAIL}

	# Origin lockdown (W6.10, deploy/EDGE.md): when Cloudflare proxies the
	# site, uncomment the CF ranges so the app sees the real client IP
	# (adapter `ADDRESS_HEADER` stays on X-Forwarded-For: Caddy still emits
	# exactly one hop). Keep grey-cloud DNS otherwise.
	# trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22
	#   103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20
	#   188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15
	#   104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	# client_ip_headers CF-Connecting-IP

	# Slow-body / idle bounds (W6.10). The presence SSE stream sends a
	# keepalive every 15s, well inside the idle timeout.
	servers {
		timeouts {
			read_body 60s
			idle 120s
		}
	}
}

# Production site (deploy note D-3). Grey-cloud DNS only: Caddy issues and
# renews over HTTP-01, which needs port 80 to reach this origin.
{$DOMAIN} {
	encode zstd gzip

	# W6.10: hard body ceiling at the edge, matching the app's own
	# BODY_SIZE_LIMIT (26M covers one 25MB upload). Larger bodies never reach
	# Node, which caps both memory and the cost of a dribble attack.
	request_body {
		max_size 26MB
	}

	# Grey-cloud DNS: uncomment to drop client-spoofable GeoIP headers.
	# Keep commented when Cloudflare (orange cloud) sets them at the edge.
	# request_header -CF-IPCountry
	# request_header -CF-Region-Code

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# `?` = set only when the app did not. The token pages answer with
		# strict-origin; a plain value here would overwrite it (the whole block is
		# deferred to response-write time because of `-Server`).
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# JSON access log for Sentinel (L2 analytics) — ledger §25 / plan §C.3.
	# Confirm/unsubscribe carry a permanent bearer token in the query string;
	# logging their URIs would hand every log reader control of any subscriber.
	@logged not path */subscribe/confirm* */unsubscribe* */reset-password* /api/auth/*
	log @logged {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 10
			# W6.11: short retention is a privacy promise. 720h = 30 days;
			# the JSON access log is the only place an IP is ever observed.
			roll_keep_for 720h
		}
		format json
	}

	# `flush_interval -1` disables response buffering so the presence SSE
	# stream is not held back by the proxy (plan §B.3).
	reverse_proxy app:3000 {
		flush_interval -1
	}
}

# Cloudflare orange cloud (deferred, deploy note Q6): when enabled, Caddy must
# trust the CF edge or every visitor collapses onto CF's IPs —
#   trusted_proxies 172.64.0.0/13 104.16.0.0/13 ...   # CF ranges
#   client_ip_headers CF-Connecting-IP
# and the app's ADDRESS_HEADER plumbing stays unchanged (Caddy still forwards
# a single X-Forwarded-For hop).
