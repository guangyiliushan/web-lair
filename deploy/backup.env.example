# Backup credentials (deploy/backup.env, mode 600, NOT sourced by the app).
# Keeping RESTIC_* / AWS_* out of .env means a web-app RCE cannot read the
# credential that deletes or encrypts the offsite repository.
# Non-secret names the script also needs (same values as .env):
POSTGRES_USER=""
POSTGRES_DB=""
DATA_DIR=""
RESTIC_REPOSITORY=""
RESTIC_PASSWORD=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Dedicated healthchecks.io check; pinged only on a successful backup.
BACKUP_PING_URL=""
# Separate weekly check (restic check) — silence here means integrity checks stopped.
CHECK_PING_URL=""
