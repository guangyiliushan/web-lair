[Unit]
Description=web-lair jobs drain (one tick per minute)
Documentation=deploy/RUNBOOK.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/web-lair/app
# `run --rm` (not exec): every tick is its own container, so a dead app
# container cannot masquerade as a running timer. `--profile prod` is required
# because the app service is profile-gated. Exit 1 = infrastructure failure
# (alert), 2 = configuration missing.
ExecStart=/usr/bin/docker compose --profile prod run --rm --no-deps --name web-lair-drain app node jobs/drain.ts
# `--rm` dies with the docker CLI; remove a container left by a timeout/kill.
ExecStopPost=-/usr/bin/docker rm -f web-lair-drain
# Must stay below the 1-minute timer: an overrunning tick would skip the next
# one while the unit is still activating. (`docker compose run` has no
# --stop-timeout flag; the unit timeout is the bound.)
TimeoutStartSec=50
# The default stop timeout is 90s; a killed docker CLI can leave the container.
TimeoutStopSec=15
