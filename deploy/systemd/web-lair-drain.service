[Unit]
Description=web-lair jobs drain (one tick per minute)
Documentation=deploy/RUNBOOK.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=web-lair-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/srv/web-lair/app
# `run --rm` (not exec): every tick is its own container, so a dead app
# container cannot masquerade as a running timer. The wrapper loads
# compose.yaml + compose.prod.yaml (never compose.override.yaml).
# Exit 1 = infrastructure failure (alert), 2 = configuration missing.
ExecStart=/srv/web-lair/app/deploy/compose-prod.sh run --rm --no-deps --name web-lair-drain app node jobs/drain.ts
# `--rm` dies with the docker CLI; remove a container left by a timeout/kill.
ExecStopPost=-/usr/bin/docker rm -f web-lair-drain
# Longest builtin timeoutMs is 900s (links.check/projects.sync); a shorter
# unit timeout would SIGKILL the tick and skip the due waterline. The 1-minute
# timer simply waits while a tick is still active.
TimeoutStartSec=960
# The default stop timeout is 90s; a killed docker CLI can leave the container.
TimeoutStopSec=15
