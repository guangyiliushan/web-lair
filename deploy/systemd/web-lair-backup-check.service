[Unit]
Description=web-lair weekly restic repository check
Documentation=deploy/RUNBOOK.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/srv/web-lair/app/deploy/backup.env
ExecStart=/usr/bin/docker run --rm -e RESTIC_REPOSITORY -e RESTIC_PASSWORD -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY restic/restic:0.19.1 check --read-data-subset=5%
TimeoutStartSec=2h
