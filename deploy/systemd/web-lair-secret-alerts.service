[Unit]
Description=web-lair secret failure alerts (W2.5)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/web-lair/app
# The app container already carries DATABASE_URL, ALERT_WEBHOOK_URL and the
# mounted DATA_DIR; one-shot container, no build, no port.
ExecStart=/srv/web-lair/app/deploy/compose-prod.sh run --rm app node scripts/secret-alerts.ts
TimeoutStartSec=120
