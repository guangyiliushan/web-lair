[Unit]
Description=web-lair box-external dead-man ping
Documentation=deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
OnFailure=web-lair-alert@%n.service
Type=oneshot
EnvironmentFile=/srv/web-lair/app/.env
# No ExecCondition: the script itself exits 0 when no URL is configured (a
# configuration gap is not a failed check). An `ExecCondition` here duplicated
# that logic and re-introduced a systemd-vs-shell expansion question (review).
# The URL is read inside the script, never placed in this unit: systemd would
# expand ${...} here before /bin/sh sees it (double evaluation).
ExecStart=/bin/sh /srv/web-lair/app/deploy/systemd/web-lair-deadman.sh
# The unit needs a network round-trip and read access to its script; nothing
# else. Hardening mirrors the drain/backup units.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=
