[Unit]
Description=web-lair box-external dead-man ping
Documentation=deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
OnFailure=web-lair-alert@%n.service
Type=oneshot
EnvironmentFile=/srv/web-lair/app/.env
# An unset URL is a configuration gap, not a failed check (exit 2 would page).
ExecCondition=/bin/sh -c 'test -n "${DEADMAN_PING_URL}"'
# healthchecks.io style URL. The point is that a missing ping (box dead,
# network down, timer broken) raises the alarm — silence is the signal.
ExecStart=/usr/bin/curl -fsS --max-time 10 "${DEADMAN_PING_URL}"
