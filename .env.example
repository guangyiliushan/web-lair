# PostgreSQL
POSTGRES_USER="root"
POSTGRES_PASSWORD="root"
POSTGRES_DB="local"

# Drizzle
# App reads this verbatim (Compose does not expand ${...} in .env); the
# container overrides the host part with `db`. Password must stay URL-safe and
# identical to POSTGRES_PASSWORD (compose.prod.yaml rebuilds the DSN).
DATABASE_URL="postgres://root:root@localhost:5432/local"

# Absolute origin used in mail links and better-auth; production must set it.
ORIGIN="http://localhost:4173"

# Better Auth
# Production: 32 characters, high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Optional keyring (official option): "<version>:<secret>[,...]" newest first.
# SET: writes use the first version ("$ba$..." envelopes; older stay readable)
# and this replaces the cookie/JWT signing secret (all sessions sign out on
# restart); wraps OAuth tokens + 2FA secrets — keep every version a stored 2FA
# secret needs and keep BETTER_AUTH_SECRET set while bare-hex values exist.
# UNSET: BETTER_AUTH_SECRET alone keys values (bare hex, no envelope).
BETTER_AUTH_SECRETS=""

# Password KDF: `argon2id` (default) or `scrypt` (better-auth legacy format).
# Verification detects the stored format, so existing argon2id hashes keep
# working in either mode (no lockout).
PASSWORD_HASH_ALGO="argon2id"

# Admin access
ADMIN_LOGIN_SLUG="secure-abc123"
DEV_ADMIN_BYPASS="false"
ADMIN_SETUP_TOKEN=""

# Readiness token: GET /api/ready probes DB + Valkey, internal-only. Set →
# `Authorization: Bearer *** REQUIRED from every caller; unset in production
# the route is 404 (the private-address fallback trusts X-Forwarded-For, so it
# is dev-only; Caddy 404s the path at the edge either way — deploy/Caddyfile).
READY_TOKEN=""

# --- Runtime secret store (encrypted DB credentials) ------------------------
# AES-256-GCM keyring for ai_provider_secrets / webhook_secrets:
# "<version>:<base64 32B>[,...]", ACTIVE must be one of them (`openssl rand
# -base64 32). REQUIRED once an encrypted row exists — without it those rows
# fail closed (`store_unavailable`, no plaintext fallback). Rotation:
# Three-phase rotation: distribute → activate → retire after the backup window.
SECRETS_KEYS=""
SECRETS_KEY_ACTIVE=""
# Legacy single-key form (read as version 1); prefer SECRETS_KEYS + _ACTIVE.
# Never derive from BETTER_AUTH_SECRET — rotating auth would destroy credentials.
SECRETS_KEY=""

# Jobs drain: optional Uptime Kuma push URL; each `node jobs/drain.ts` tick sends one GET.
JOBS_HEARTBEAT_URL=""

# healthchecks.io ping URLs (one CHECK per probe so a dead disk cannot mask a
# dead mailer): base ping URL; probes append `/fail` on failure, ping the base
# when healthy. Empty = skipped (dev).
HEALTHCHECKS_RESOURCES_URL=""
HEALTHCHECKS_MAIL_URL=""

# Jobs data dir: user job scripts + SDK scaffold (`$DATA_DIR/jobs`).
# Dev default <repo>/data (gitignored); production = absolute host path, part
# of the restic backup set.
DATA_DIR=""

# Tailnet sign-in (src/lib/server/security/tailscale-auth.ts)
# Tailnet logins allowed to sign in — NOT emails (GitHub-backed tailnet uses
# `name@github`); empty = every tailnet source refused.
TAILSCALE_OWNER_LOGINS=""
# Loopback sign-in outside `vite dev`. Keep OFF when reachable through
# `tailscale serve`/Funnel — Funnel carries no identity header, so every
# proxied peer would sign in as owner.
TAILSCALE_ALLOW_LOOPBACK="false"
# Optional absolute path to the Tailscale CLI (Windows: C:/Program Files/Tailscale/tailscale.exe)
TAILSCALE_CLI=""

# Owner seed (pnpm ops site seed-owner); OWNER_EMAIL required.
OWNER_EMAIL=""
OWNER_PASSWORD=""

# GitHub OAuth — https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Three scopes — never interchange them:
#   GITHUB_CLIENT_ID/SECRET - OAuth sign-in; no API quota.
#   GITHUB_TOKEN            - embed rich cards (/api/embed-meta reads it at
#                             request time; admin only reports whether it is
#                             set). Optional: 60 req/h anonymous → 5,000/h with
#                             it; never stored or rendered.
#   PROJECTS_GITHUB_TOKEN   - project sync (see below); separate quota.
GITHUB_TOKEN=""

# Google OAuth — planned, not wired into auth.ts (the account page shows it as
# planned and never accepts credentials). https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (storage line; dev stack in compose.yaml): RustFS S3 endpoint,
# loopback only; credentials shared by the compose stack and the app ($env).
RUSTFS_ENDPOINT="http://127.0.0.1:9000"
RUSTFS_ACCESS_KEY=""
RUSTFS_SECRET_KEY=""
RUSTFS_BUCKET="web-lair"

# External S3 driver: read only when the ACTIVE provider has driver=s3;
# endpoint/region/bucket come from the storage page (owner-only, inactive until
# `pnpm ops storage migrate --cutover`). Never rendered, logged or stored — the
# encrypted write-only store takes precedence once it holds a row.
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""
# Opt-in for a private (LAN) endpoint (e.g. MinIO); cloud metadata addresses
# stay rejected either way, https still required.
ALLOW_PRIVATE_STORAGE_ENDPOINT="false"

# Cache layer (storage line; Valkey 9 — fail-open, restart may reset)
VALKEY_URL="redis://127.0.0.1:6379"

# Projects sync (projects line; all optional — anonymous works): tokens raise
# per-IP quotas (GitHub 60/h → 5,000/h), never leave the env or hit the DB.
# This PROJECTS_GITHUB_TOKEN is the sync adapter only — embed uses GITHUB_TOKEN.
PROJECTS_GITHUB_TOKEN=""
PROJECTS_GITLAB_TOKEN=""
PROJECTS_GITEE_TOKEN=""
PROJECTS_BITBUCKET_USER=""
PROJECTS_BITBUCKET_TOKEN=""

# --- Deployment (compose `--profile prod`) -----------------------------------
# Public origin (no trailing slash), must match the Caddy host and ORIGIN above.
DOMAIN=""
ACME_EMAIL=""
APP_IMAGE="web-lair-app:local"
# adapter-node limit: 26M covers one 25MB upload/request (uploaders go one by one).
BODY_SIZE_LIMIT="26M"

# --- Self-hosted speech-to-text (compose `whisper`) -------------------------
# whisper-asr-webservice, dev port (9000/9001 are RustFS); prod uses http://whisper:9000.
WHISPER_URL="http://127.0.0.1:9100"
WHISPER_MODEL="base"
# Build-time proxy for the local image (empty = direct); not persisted into the runtime image.
WHISPER_BUILD_PROXY=""
# Trust one proxy hop (Caddy); Cloudflare needs Caddy-side trusted_proxies first (deploy/Caddyfile).
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"

# --- Comment geo -------------------------------------------------------------
# Deployment-header GeoIP: name the headers the edge sets; empty = no provider
# (collectCountry stays unavailable). Values normalised (ISO 3166-1 alpha-2 /
# region code), no third-party lookup. Cloudflare: CF-IPCountry / CF-Region-Code.
GEOIP_COUNTRY_HEADER=""
GEOIP_REGION_HEADER=""

# The /data mount = DATA_DIR above (user jobs + sidecars); absolute path in production.

# --- Mail --------------------------------------------------------------------
# SMTP submission: requires "true" AND a host, else fails loudly in prod / logs in dev.
MAIL_ENABLED="false"
# Dev/e2e only: log mail instead of throwing without SMTP. Production ignores it
# unless MAIL_DEV_LOG_OK=true (a stray value cannot become a token logger).
MAIL_DEV_LOG="false"
MAIL_DEV_LOG_OK="false"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_SECURE="false"
# Empty = auto (mandatory STARTTLS for non-loopback hosts, off for a local MTA).
MAIL_SMTP_REQUIRE_TLS=""
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
# Required when MAIL_ENABLED=true; sign-up refuses to start without it (DKIM subdomain).
MAIL_FROM=""
# DKIM signed in-process by nodemailer (MTA only relays); PEM with literal \n escapes.
MAIL_DKIM_DOMAIN=""
MAIL_DKIM_SELECTOR=""
MAIL_DKIM_PRIVATE_KEY=""

# --- Email hardening ---------------------------------------------------------
# Confirmation-link TTL in days (default 1; NIST SP 800-63B-4 §4.2.1.2 bound).
# Positive whole days only, else 1; 3-day/72h is an explicit override, larger
# values clamp with a warning. Unsubscribe links are not TTL-bound, but a
# resubmit rotates the token (older mails' links die).
SUBSCRIBE_TOKEN_TTL_DAYS="1"
# 32B base64 (`openssl rand -base64 32`); keys the per-address cap so the cache
# never holds a plaintext address. Empty = IP-only limiting with a warning.
SUBSCRIBE_HMAC_KEY=""
# 32B base64; derives the mailed confirmation token from `token_nonce`
# (HMAC-SHA256) — the DB holds no usable link. Rotating invalidates pending
# links only (24-72h TTL), never data. REQUIRED in production (fails boot).
SUBSCRIBE_TOKEN_SECRET=""
# 32B base64, independent of the auth secret — master key for every key
# version; keep it in backups. REQUIRED in production (no unkeyed fallback,
# fails boot) and in development for /subscribe + /unsubscribe reads.
SUPPRESSION_HMAC_KEY=""
# Positive integer, default 1: v1 = HMAC(SUPPRESSION_HMAC_KEY, email), v>=2 =
# HMAC(master, 'wl:suppression:key:vN'). Bump to rotate (rows converge when
# touched); never set below the highest stored `key_version` —
# `db verify-suppression-version` gates that.
SUPPRESSION_HMAC_KEY_VERSION="1"
# HMAC key for POST /api/mail/events (bounce/complaint intake); must decode to
# exactly 32 bytes. Empty = endpoint 503s instead of accepting unsigned events.
MAIL_EVENTS_HMAC_KEY=""

# --- AI providers ------------------------------------------------------------
# Provider keys: created here, referenced BY NAME in Admin → Settings → AI
# (密钥环境变量名); only AI_*-prefixed names, values never reach the DB or a
# page. One line per provider, e.g. `AI_OPENAI_KEY=""`.
# Comma-separated hosts allowed to resolve to private/LAN addresses (Ollama,
# vLLM, LiteLLM...); public hosts (api.openai.com, api.deepseek.com) need none.
AI_ALLOW_PRIVATE_HOSTS=""

# --- Monitoring ---------------------------------------------------------------
# Backup credentials live in deploy/backup.env (mode 600), never in this file.
# healthchecks.io style liveness URL; a missing ping is the alarm (systemd timer).
DEADMAN_PING_URL=""
# Optional: systemd OnFailure target (web-lair-alert@.service).
ALERT_WEBHOOK_URL=""

# --- Monitoring: Gatus (deploy/monitoring/) ---------------------------------
# Read by compose.monitoring.yaml + the render step; empty = feature OFF —
# BARK_URL=log-only alerts, SITE_DOMAIN=no TLS checks, DRAIN_HEARTBEAT_TOKEN=no
# drain heartbeat, READY_TOKEN=no /api/ready monitor. Details: README §4/§5.
# Bark push URL INCLUDING the device key, e.g. https://api.day.app/<DEVICE_KEY>.
# Must be https:// (render-config.sh refuses http), no spaces/quotes/`$`; treat
# as secret (mode 600, never git). Gatus logs failed sends with the full URL —
# treat gatus container logs as credential-bearing.
BARK_URL=""
# Public host Caddy serves (no scheme), e.g. blog.example.com; monitoring only.
SITE_DOMAIN=""
# Drain Gatus push bearer; set only after wiring (README §8): un-pinged endpoints alert by design.
DRAIN_HEARTBEAT_TOKEN=""
# READY_TOKEN: declared above; this block only documents its Gatus use (zz-app-ready.yaml).
# Monitor targets (compose defaults = service names); override for non-compose layouts.
MONITOR_APP_ADDR=""
MONITOR_PG_ADDR=""
MONITOR_RUSTFS_ADDR=""
MONITOR_INTERVAL=""
MONITOR_FAILURE_THRESHOLD=""
MONITOR_SUCCESS_THRESHOLD=""
# Gatus container log level (INFO/DEBUG).
GATUS_LOG_LEVEL=""
# healthchecks.io (box-external vantage — the channel that survives a dead
# host); unset = ping skipped.
#   HC_DEADMAN_URL  WIRED: systemd deadman prefers it, falls back to
#                   DEADMAN_PING_URL (liveness, period 5m / grace 5m).
#   HC_BACKUP_URL   NOT READ YET (Backrest CONDITION_SNAPSHOT_END hook; today
#                   deploy/backup.env's BACKUP_PING_URL is live) (1d / 6h).
HC_DEADMAN_URL=""
HC_BACKUP_URL=""

# --- Notifications: admin alert outbox ---------------------------------------
# Email notifications reuse the SMTP block above; an unconfigured relay fails
# an email delivery `failed` permanently instead of retrying (log says why).
# Bark device key: read from this env file only (an at-rest store needs a
# `notification_secrets` table the schema window did not approve). Without it
# the channel reports "not configured" and queued pushes are NOT attempted.
# Self-hosted Bark: origin https only; LAN needs WEBHOOK_ALLOW_PRIVATE_TARGETS=true.
BARK_SERVER_URL=""
BARK_DEVICE_KEY=""

# --- Traffic analytics -------------------------------------------------------
# Sentinel runs internal-only (deploy/monitoring/compose.sentinel.yaml);
# compose.prod.yaml sets http://sentinel:8888 — empty for local dev (analytics
# renders "—"), or point at a host port. SENTINEL_TOKEN (hex-32 from
# deploy/bootstrap-secrets.sh) is required: without it the page degrades and a
# full-stack `up` refuses to start (targeted commands still work).
SENTINEL_URL=""
SENTINEL_TOKEN=""
