# PostgreSQL
POSTGRES_USER="root"
POSTGRES_PASSWORD="root"
POSTGRES_DB="local"

# Drizzle
# The app reads this verbatim; fill real values (Compose does not expand ${...}
# inside .env values). The container overrides the host part with `db`.
# Keep the password URL-safe and identical to POSTGRES_PASSWORD — compose.prod.yaml
# rebuilds this DSN from POSTGRES_* and refuses a malformed value (RUNBOOK §1.1).
DATABASE_URL="postgres://root:root@localhost:5432/local"

# Absolute origin used in mail links and better-auth; production must set it.
ORIGIN="http://localhost:4173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Optional better-auth keyring (official option; W1.5). Format:
# "<version>:<secret>[,<version>:<secret>...]" with the NEWEST version first.
# When SET, new writes use the first version and are stored as
# "$ba$<version>$..." envelopes; older versions stay readable. When UNSET,
# BETTER_AUTH_SECRET alone keys every value and encrypted values are BARE HEX
# (no envelope). Setting or changing this also replaces the cookie/JWT signing
# secret, so every current session is signed out on restart. It wraps OAuth
# tokens AND 2FA secrets: keep every version a stored 2FA secret still needs,
# and keep BETTER_AUTH_SECRET set while bare-hex values exist.
# Rotation and rollback: deploy/RUNBOOK.md §3.1.
BETTER_AUTH_SECRETS=""

# Admin access
ADMIN_LOGIN_SLUG="secure-abc123"
DEV_ADMIN_BYPASS="false"
ADMIN_SETUP_TOKEN=""

# --- Runtime secret store (W2: encrypted DB credentials) ---------------------
# AES-256-GCM keyring for ai_provider_secrets / webhook_secrets. Format:
# "<version>:<base64 32B>[,<version>:<base64 32B>...]" and the ACTIVE version
# must be one of them. Generate one key with `openssl rand -base64 32`.
# REQUIRED once an encrypted key/secret exists: without it those rows fail
# closed (`store_unavailable`), they never fall back to plaintext.
# Rotation is three-phase (deploy/RUNBOOK.md §4.2): distribute -> activate ->
# retire after the backup retention window.
SECRETS_KEYS=""
SECRETS_KEY_ACTIVE=""
# Legacy single-key form, read as version 1. Kept for existing installs; new
# deployments should use SECRETS_KEYS + SECRETS_KEY_ACTIVE. Never derive this
# from BETTER_AUTH_SECRET: rotating auth would destroy every stored credential.
SECRETS_KEY=""

# Jobs drain (jobs line, ledger §24)
# Optional Uptime Kuma-style push URL; each `node jobs/drain.ts` tick sends one GET.
JOBS_HEARTBEAT_URL=""

# Jobs data dir (jobs line, J-2; ledger §24)
# Persistent directory for user job scripts and the generated SDK scaffold
# (`$DATA_DIR/jobs`). Dev default: <repo>/data (gitignored). Production: an
# absolute host-mounted path, part of the restic backup set (ledger §25).
DATA_DIR=""

# Tailnet sign-in (read by src/lib/server/security/tailscale-auth.ts)
# Comma/whitespace separated tailnet logins allowed to sign in. NOT emails: a
# GitHub-backed tailnet uses `name@github`. Empty = every tailnet source refused.
TAILSCALE_OWNER_LOGINS=""
# Loopback sign-in outside `vite dev` (preview / self-hosted bound to 127.0.0.1).
# Keep it OFF when the app is reachable through `tailscale serve` or Funnel -
# Funnel carries no identity header, so every proxied peer would sign in as owner.
TAILSCALE_ALLOW_LOOPBACK="false"
# Optional absolute path to the Tailscale CLI
# (Windows default: C:/Program Files/Tailscale/tailscale.exe)
TAILSCALE_CLI=""

# Owner seed (pnpm db:seed-owner)
# OWNER_EMAIL is required.
OWNER_EMAIL=""
OWNER_PASSWORD=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (planned, not wired into auth.ts yet; the account page shows it
# as planned and never accepts credentials through the UI)
# https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (storage line, ledger §21; dev stack in compose.yaml)
# RustFS S3-compatible endpoint — loopback only; credentials shared by the compose
# stack (container) and the app ($env/dynamic/private).
RUSTFS_ENDPOINT="http://127.0.0.1:9000"
RUSTFS_ACCESS_KEY=""
RUSTFS_SECRET_KEY=""
RUSTFS_BUCKET="web-lair"

# Cache layer (storage line, ledger §21; Valkey 9 — fail-open, restart may reset)
VALKEY_URL="redis://127.0.0.1:6379"

# Projects sync (projects line, ledger §18; all optional — anonymous works)
# Tokens raise the per-IP quotas (GitHub 60/h → 5,000/h etc.). Keys never
# leave the server environment and are never stored in the database.
PROJECTS_GITHUB_TOKEN=""
PROJECTS_GITLAB_TOKEN=""
PROJECTS_GITEE_TOKEN=""
PROJECTS_BITBUCKET_USER=""
PROJECTS_BITBUCKET_TOKEN=""

# --- Deployment (deploy batch D-1; compose `--profile prod`) -----------------
# Public origin, no trailing slash. Must match the Caddy site host.
# ORIGIN is already declared above; keep both in sync.
DOMAIN=""
ACME_EMAIL=""
APP_IMAGE="web-lair-app:local"
# adapter-node request limits. 26M covers one 25MB upload per request; the
# admin uploaders submit files one by one (see admin files/photos pages).
BODY_SIZE_LIMIT="26M"

# --- Self-hosted speech-to-text (compose `whisper`) -------------------------
# whisper-asr-webservice on the dev host port (9000/9001 are RustFS).
# In production compose.prod.yaml overrides this with http://whisper:9000.
WHISPER_URL="http://127.0.0.1:9100"
WHISPER_MODEL="base"
# Build-time proxy for the local whisper image (empty = direct). Do not set
# this at runtime; the Dockerfile does not persist it into the image.
WHISPER_BUILD_PROXY=""
# Trust exactly one proxy hop (Caddy). Cloudflare orange cloud would require
# Caddy-side trusted_proxies first (see deploy/Caddyfile).
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"

# Host path mounted into the app as /data (user job scripts + sidecars).
# Part of backup set ② — use an absolute path in production.
# DATA_DIR is already declared above.

# --- Mail (deploy batch D-2) ------------------------------------------------
# SMTP submission. MAIL_ENABLED must be "true" AND a host set, otherwise the
# transport fails loudly in production and logs to the console in dev.
MAIL_ENABLED="false"
# Development / e2e only: log mail instead of throwing when SMTP is absent.
# In production this is ignored unless MAIL_DEV_LOG_OK=true is also set, so a
# stray value cannot turn the deployment into a token logger.
MAIL_DEV_LOG="false"
MAIL_DEV_LOG_OK="false"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_SECURE="false"
# Empty = auto (mandatory STARTTLS for non-loopback hosts, off for a local MTA).
MAIL_SMTP_REQUIRE_TLS=""
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
# Required when MAIL_ENABLED=true; must live on the DKIM-signing subdomain
# (e.g. mail.example.com). Sign-up refuses to start without it.
MAIL_FROM=""
# DKIM is signed in-process by nodemailer; the MTA only relays.
# Private key: PEM with literal \n escapes accepted by the transport.
MAIL_DKIM_DOMAIN=""
MAIL_DKIM_SELECTOR=""
MAIL_DKIM_PRIVATE_KEY=""

# --- Email hardening E1 -----------------------------------------------------
# Confirmation links expire after this many days: default 1 (borrowed from
# NIST SP 800-63B-4 §4.2.1.2, which bounds emailed recovery codes, not list
# subscriptions). Only positive whole days are accepted; anything else falls
# back to 1. The 3-day / 72h value is an explicit exceptional override; larger
# values are clamped with a warning. Unsubscribe links are not TTL-bound, but a
# resubmit rotates the token, so older mails' links stop working.
SUBSCRIBE_TOKEN_TTL_DAYS="1"
# 32 random bytes, base64 (`openssl rand -base64 32`). Keys the per-address
# subscribe cap so the cache never holds a plaintext address. Empty = degrade
# to IP-only limiting with an explicit warning.
SUBSCRIBE_HMAC_KEY=""
# F-13: 32 random bytes, base64 (`openssl rand -base64 32`). Derives the mailed
# confirmation token from the stored `token_nonce` (HMAC-SHA256). The database
# holds no usable link; rotating this secret only invalidates pending links
# (24-72h TTL), never data. REQUIRED in production: missing/invalid fails boot.
SUBSCRIBE_TOKEN_SECRET=""
# E2: suppression list hash key (32B base64, independent of the auth secret;
# keep it in backups — it is the master key for every key version).
# REQUIRED in production: missing/invalid fails the app boot (no unkeyed fallback).
# Also required in development for /subscribe and /unsubscribe (reads included).
SUPPRESSION_HMAC_KEY=""
# F-14: active suppression key version (positive integer, default 1). Version 1
# is `HMAC(SUPPRESSION_HMAC_KEY, email)`; v>=2 derive their key from the same
# master (`HMAC(master, 'wl:suppression:key:vN')`). Bump it to rotate new
# writes; rows converge when touched. Never set it below the highest stored
# `key_version` — `db:verify-suppression-version` gates that.
SUPPRESSION_HMAC_KEY_VERSION="1"
# E2: HMAC key for POST /api/mail/events (bounce/complaint intake). Must decode
# to exactly 32 bytes; empty disables the endpoint with 503 rather than
# accepting unsigned events.
MAIL_EVENTS_HMAC_KEY=""

# --- AI providers -----------------------------------------------------------
# Provider keys are created here and referenced BY NAME in
# Admin → Settings → AI (密钥环境变量名). Only AI_*-prefixed names are
# accepted; values never reach the database or a page. Add one line per
# provider, e.g.:
# AI_OPENAI_KEY=""
# AI_DEEPSEEK_KEY=""
# Comma-separated hosts allowed to resolve to private / LAN addresses
# (Ollama, vLLM, LiteLLM...). Public hosts such as api.deepseek.com or
# api.openai.com need no entry.
AI_ALLOW_PRIVATE_HOSTS=""

# --- Monitoring (deploy batch D-4) -----------------------------------------
# Backup credentials live in deploy/backup.env (mode 600), never in this file.
# healthchecks.io style liveness URL; a missing ping is the alarm (systemd timer).
DEADMAN_PING_URL=""
# Optional: systemd OnFailure target (web-lair-alert@.service).
ALERT_WEBHOOK_URL=""

