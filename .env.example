# PostgreSQL
POSTGRES_USER="root"
POSTGRES_PASSWORD="root"
POSTGRES_DB="local"

# Drizzle
# The app reads this verbatim; fill real values (Compose does not expand ${...}
# inside .env values). The container overrides the host part with `db`.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/local"

# Absolute origin used in mail links and better-auth; production must set it.
ORIGIN="http://localhost:4173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Admin access
ADMIN_LOGIN_SLUG="secure-abc123"
DEV_ADMIN_BYPASS="false"
ADMIN_SETUP_TOKEN=""

# Jobs drain (jobs line, ledger §24)
# Optional Uptime Kuma-style push URL; each `node jobs/drain.ts` tick sends one GET.
JOBS_HEARTBEAT_URL=""

# Jobs data dir (jobs line, J-2; ledger §24)
# Persistent directory for user job scripts and the generated SDK scaffold
# (`$DATA_DIR/jobs`). Dev default: <repo>/data (gitignored). Production: an
# absolute host-mounted path, part of the restic backup set (ledger §25).
DATA_DIR=""

# Tailnet sign-in (read by src/lib/server/security/tailscale-auth.ts)
# Comma/whitespace separated tailnet logins allowed to sign in. NOT emails: a
# GitHub-backed tailnet uses `name@github`. Empty = every tailnet source refused.
TAILSCALE_OWNER_LOGINS=""
# Loopback sign-in outside `vite dev` (preview / self-hosted bound to 127.0.0.1).
# Keep it OFF when the app is reachable through `tailscale serve` or Funnel -
# Funnel carries no identity header, so every proxied peer would sign in as owner.
TAILSCALE_ALLOW_LOOPBACK="false"
# Optional absolute path to the Tailscale CLI
# (Windows default: C:/Program Files/Tailscale/tailscale.exe)
TAILSCALE_CLI=""

# Owner seed (pnpm db:seed-owner)
# OWNER_EMAIL is required.
OWNER_EMAIL=""
OWNER_PASSWORD=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Object storage (storage line, ledger §21; dev stack in compose.yaml)
# RustFS S3-compatible endpoint — loopback only; credentials shared by the compose
# stack (container) and the app ($env/dynamic/private).
RUSTFS_ENDPOINT="http://127.0.0.1:9000"
RUSTFS_ACCESS_KEY=""
RUSTFS_SECRET_KEY=""
RUSTFS_BUCKET="web-lair"

# Cache layer (storage line, ledger §21; Valkey 9 — fail-open, restart may reset)
VALKEY_URL="redis://127.0.0.1:6379"

# Projects sync (projects line, ledger §18; all optional — anonymous works)
# Tokens raise the per-IP quotas (GitHub 60/h → 5,000/h etc.). Keys never
# leave the server environment and are never stored in the database.
PROJECTS_GITHUB_TOKEN=""
PROJECTS_GITLAB_TOKEN=""
PROJECTS_GITEE_TOKEN=""
PROJECTS_BITBUCKET_USER=""
PROJECTS_BITBUCKET_TOKEN=""

# --- Deployment (deploy batch D-1; compose `--profile prod`) -----------------
# Public origin, no trailing slash. Must match the Caddy site host.
# ORIGIN is already declared above; keep both in sync.
DOMAIN=""
ACME_EMAIL=""
APP_IMAGE="web-lair-app:local"
# adapter-node request limits. 26M covers one 25MB upload per request; the
# admin uploaders submit files one by one (see admin files/photos pages).
BODY_SIZE_LIMIT="26M"
# Trust exactly one proxy hop (Caddy). Cloudflare orange cloud would require
# Caddy-side trusted_proxies first (see deploy/Caddyfile).
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"

# Host path mounted into the app as /data (user job scripts + sidecars).
# Part of backup set ② — use an absolute path in production.
# DATA_DIR is already declared above.

# --- Mail (deploy batch D-2) ------------------------------------------------
# SMTP submission. MAIL_ENABLED must be "true" AND a host set, otherwise the
# transport fails loudly in production and logs to the console in dev.
MAIL_ENABLED="false"
# Development / e2e only: log mail instead of throwing when SMTP is absent.
# In production this is ignored unless MAIL_DEV_LOG_OK=true is also set, so a
# stray value cannot turn the deployment into a token logger.
MAIL_DEV_LOG="false"
MAIL_DEV_LOG_OK="false"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_SECURE="false"
# Empty = auto (mandatory STARTTLS for non-loopback hosts, off for a local MTA).
MAIL_SMTP_REQUIRE_TLS=""
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
# Required when MAIL_ENABLED=true; must live on the DKIM-signing subdomain
# (e.g. mail.example.com). Sign-up refuses to start without it.
MAIL_FROM=""
# DKIM is signed in-process by nodemailer; the MTA only relays.
# Private key: PEM with literal \n escapes accepted by the transport.
MAIL_DKIM_DOMAIN=""
MAIL_DKIM_SELECTOR=""
MAIL_DKIM_PRIVATE_KEY=""

# --- Email hardening E1 -----------------------------------------------------
# Confirmation links expire after this many days: default 1 (NIST SP 800-63B-4
# §4.2: emailed recovery codes SHALL expire within 24h). The 3-day / 72h value
# is an explicit exceptional override, not the default; larger values are
# clamped with a warning. Unsubscribe links never expire.
SUBSCRIBE_TOKEN_TTL_DAYS="1"
# 32 random bytes, base64 (`openssl rand -base64 32`). Keys the per-address
# subscribe cap so the cache never holds a plaintext address. Empty = degrade
# to IP-only limiting with an explicit warning.
SUBSCRIBE_HMAC_KEY=""
# E2: suppression list hash key (32B base64, independent of the auth secret;
# keep it in backups — rotating it orphans every stored suppression hash).
# REQUIRED in production: missing/invalid fails the app boot (no unkeyed fallback).
# Also required in development for /subscribe and /unsubscribe (reads included).
SUPPRESSION_HMAC_KEY=""
# E2: HMAC key for POST /api/mail/events (bounce/complaint intake). Must decode
# to exactly 32 bytes; empty disables the endpoint with 503 rather than
# accepting unsigned events.
MAIL_EVENTS_HMAC_KEY=""

# --- Monitoring (deploy batch D-4) -----------------------------------------
# Backup credentials live in deploy/backup.env (mode 600), never in this file.
# healthchecks.io style liveness URL; a missing ping is the alarm (systemd timer).
DEADMAN_PING_URL=""
# Optional: systemd OnFailure target (web-lair-alert@.service).
ALERT_WEBHOOK_URL=""

