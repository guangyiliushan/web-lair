# PostgreSQL
POSTGRES_USER="root"
POSTGRES_PASSWORD="root"
POSTGRES_DB="local"

# Drizzle
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Admin access
ADMIN_LOGIN_SLUG="secure-abc123"
DEV_ADMIN_BYPASS="false"
ADMIN_SETUP_TOKEN=""

# Tailnet sign-in (read by src/lib/server/security/tailscale-auth.ts)
# Comma/whitespace separated tailnet logins allowed to sign in. NOT emails: a
# GitHub-backed tailnet uses `name@github`. Empty = every tailnet source refused.
TAILSCALE_OWNER_LOGINS=""
# Loopback sign-in outside `vite dev` (preview / self-hosted bound to 127.0.0.1).
# Keep it OFF when the app is reachable through `tailscale serve` or Funnel -
# Funnel carries no identity header, so every proxied peer would sign in as owner.
TAILSCALE_ALLOW_LOOPBACK="false"
# Optional absolute path to the Tailscale CLI
# (Windows default: C:/Program Files/Tailscale/tailscale.exe)
TAILSCALE_CLI=""

# Owner seed (pnpm db:seed-owner)
# OWNER_EMAIL is required.
OWNER_EMAIL=""
OWNER_PASSWORD=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
